# ---------------------------------------------------------------------------
# AWS AI League - Agentic Football : environment template
# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust if needed:
#
#     Copy-Item .env.example .env      (bash:  cp .env.example .env)
#
# ".env" is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# -- AWS CREDENTIALS: DO NOT PUT THEM HERE --------------------------------
# boto3 uses the default AWS credential provider chain:
#   * environment variables set OUTSIDE this repo
#   * ~/.aws/credentials  /  ~/.aws/config   (aws configure / aws sso login)
#   * IAM role (EC2 / ECS / Lambda)
# Never hardcode access keys, secret keys, or session tokens in the repo.

# -- Optional routing overrides (NOT secrets) ---------------------------
# The Bedrock layer already defaults to these values, so you normally
# leave this file untouched.
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0

# -- Feature flag -------------------------------------------------------
# The deterministic engine ignores this. It only affects future code
# that chooses between the deterministic path and the advisory LLM path.
USE_BEDROCK=false
